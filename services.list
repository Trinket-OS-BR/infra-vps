# Serviços que a VPS mantém de pé, na ordem de subida (uma pasta por linha; # desliga).
# Entram um a um, só depois que o anterior estiver estável.
platform/postgres
# Exige platform/redis/.env (senha do administrador, gerada na VPS).
platform/redis
# Exige platform/rabbitmq/.env (senha do administrador, gerada na VPS).
platform/rabbitmq
# Exige platform/observability/.env (senha do administrador, gerada na VPS).
platform/observability
# O Offer exige .env e .env.production na pasta (o deploy do CI grava os dois).
apps/offer/production/web
# TrinketOS API: exige .env, .env.production e /srv/secrets/trinketos-api-infra.env (make-infra-env.sh).
apps/trinketos/production/api
# TrinketOS web: exige .env e .env.production na pasta (o deploy do CI grava os dois); chama a API pela rede data.
apps/trinketos/production/web
# TrinketOS workspace: exige .env e .env.production na pasta (o deploy do CI grava os dois); chama a API pela rede data.
apps/trinketos/production/workspace
# TrinketOS design (Storybook estático): exige .env e .env.production na pasta (o deploy do CI grava os dois).
apps/trinketos/production/design
# TrinketOS learn: exige .env e .env.production na pasta (o deploy do CI grava os dois); chama a API pela rede data.
apps/trinketos/production/learn
# O proxy vem por último: só recebe tráfego de quem já está de pé. Exige platform/proxy/.env.
platform/proxy
