# Copie para .env.production (modo 600, fora do Git). Só os NOMES estão aqui; os valores ficam na VPS.
# DATABASE_URL e DATABASE_SSL vêm do arquivo gerado por scripts/postgres-create-db.sh:
#   cat /srv/secrets/offer-db.env >> .env.production
# Os demais são digitados no editor (nano), nunca colados em chat.
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://<DOMINIO-DO-OFFER>
R2_ENDPOINT=CHANGE_ME
R2_BUCKET_NAME=CHANGE_ME
R2_PREFIX=CHANGE_ME
R2_ACCESS_KEY=CHANGE_ME
R2_SECRET_KEY=CHANGE_ME
R2_PUBLIC_URL=CHANGE_ME
WHATSAPP_NUMBER=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME
SESSION_SECRET=CHANGE_ME
