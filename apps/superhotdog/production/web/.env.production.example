# Flag de renderizacao (kill switch do desenvolvedor, usado em caso de atraso de pagamento do contrato).
# Com RENDER=false a aplicacao exibe apenas a tela de manutencao e os endpoints de pedido/checkout retornam 503.
RENDER="true"

# PostgreSQL da plataforma (um banco por produto). Criado na VPS com:
#   scripts/postgres-create-db.sh superhotdog /srv/secrets/superhotdog-db.env
# Em desenvolvimento local, acesse por tunel SSH (ex.: ssh -L 4130:platform-postgres:4130 <vps>)
# e use host localhost na URL. Nao crie containers na maquina local.
DATABASE_URL="postgresql://superhotdog:SENHA@platform-postgres:4130/superhotdog"
DATABASE_SSL="false"

# RabbitMQ da plataforma (um vhost por produto). Criado na VPS com:
#   scripts/rabbitmq-create-vhost.sh superhotdog /srv/secrets/superhotdog-rabbitmq.env
RABBITMQ_AMQP_URL="amqp://superhotdog:SENHA@platform-rabbitmq:4132/superhotdog"

# Google OAuth (login com Google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenObserve da plataforma (OTLP/HTTP). Organizacao e usuario criados na VPS com:
#   scripts/observability-create-org.sh superhotdog /srv/secrets/superhotdog-observability.env
# Esse arquivo ja traz as tres variaveis abaixo prontas. Deixe vazio para desligar.
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf"
OTEL_EXPORTER_OTLP_HEADERS=""
OTEL_SERVICE_NAME="superhotdog-web"

# Cloudflare R2 (imagens de produto convertidas para .jxl + .webp). Sem R2, em desenvolvimento
# os arquivos vao para public/uploads; em producao o upload falha se estas variaveis faltarem.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# URL publica do bucket (dominio custom ou r2.dev), sem barra no final
R2_PUBLIC_URL=""

# Runtime de produção (porta interna da plataforma; sem exposição no host)
NODE_ENV="production"
HOST="0.0.0.0"
PORT="4128"
DATABASE_POOL_MAX="5"
VITE_APP_URL="https://shd.antoniobsilva.com.br"

# Web Push: gere um par exclusivo por ambiente. Nunca exponha a chave privada.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""

# Upload de PDFs via UploadThing (opcional; recibos também têm retorno em base64)
UPLOADTHING_TOKEN=""

# Integrações públicas do cliente: fornecidas durante o build da imagem
VITE_GA_MEASUREMENT_ID=""
VITE_EMAILJS_SERVICE_ID=""
VITE_EMAILJS_TEMPLATE_ID=""
VITE_EMAILJS_PUBLIC_KEY=""
VITE_SENTRY_DSN=""
# Token privado de publicação de sourcemaps; não passar como VITE_* nem build arg
SENTRY_AUTH_TOKEN=""
