# Copie para .env (modo 600, fora do Git). Gere a senha na VPS:
#   sed -i "s/^RABBITMQ_DEFAULT_PASS=.*/RABBITMQ_DEFAULT_PASS=$(openssl rand -hex 24)/" platform/rabbitmq/.env
# Use só letras e números (hex). O administrador é criado na primeira subida; depois, trocar a senha é por `rabbitmqctl`.
RABBITMQ_DEFAULT_USER=platform_admin
RABBITMQ_DEFAULT_PASS=CHANGE_ME
