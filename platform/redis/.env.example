# Copie para .env (modo 600, fora do Git). Gere a senha na VPS:
#   sed -i "s/^REDIS_ADMIN_PASSWORD=.*/REDIS_ADMIN_PASSWORD=$(openssl rand -hex 24)/" platform/redis/.env
# Use só letras e números (hex); caracteres especiais quebram o arquivo de ACL gerado na primeira subida.
REDIS_ADMIN_PASSWORD=CHANGE_ME
