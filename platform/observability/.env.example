# Copie para .env (modo 600, fora do Git). Gere a senha na VPS, sem imprimir:
#   sed -i "s/^ZO_ROOT_USER_PASSWORD=.*/ZO_ROOT_USER_PASSWORD=Aa1!$(openssl rand -hex 16)/" platform/observability/.env
# A senha exige 8+ caracteres com minúscula, maiúscula, número e símbolo; o prefixo "Aa1!" garante isso.
ZO_ROOT_USER_EMAIL=admin@platform.invalid
ZO_ROOT_USER_PASSWORD=CHANGE_ME
ZO_DATA_DIR=/data
ZO_HTTP_PORT=4140
ZO_GRPC_PORT=4141
# Retenção global em dias (logs, métricas e traces); cada stream pode ter a sua pelo painel.
ZO_COMPACT_DATA_RETENTION_DAYS=14
ZO_TELEMETRY=false
