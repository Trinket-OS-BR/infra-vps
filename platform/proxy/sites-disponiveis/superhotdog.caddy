shd.antoniobsilva.com.br {
  encode zstd gzip
  log
  header {
    -Server
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
  }
  reverse_proxy superhotdog-web-production:4128 {
    health_uri /api/health
    health_interval 30s
    # Keep the authenticated order-event stream responsive.
    flush_interval -1
  }
}
