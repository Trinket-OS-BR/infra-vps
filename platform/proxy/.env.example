# Copie para .env (modo 600, fora do Git).
# E-mail para avisos de certificado (Let's Encrypt) e domínio que o proxy atende.
ACME_EMAIL=CHANGE_ME
OFFER_DOMAIN=offer.example.com
LOGS_DOMAIN=logs.example.com
# Domínios do produto TrinketOS (só valem quando o conjunto "trinketos" estiver ligado: scripts/proxy-site.sh).
TRINKETOS_WEB_DOMAIN=app.example.com
TRINKETOS_API_DOMAIN=api.example.com
TRINKETOS_WORKSPACE_DOMAIN=workspace.example.com
TRINKETOS_DESIGN_DOMAIN=design.example.com
TRINKETOS_LEARN_DOMAIN=learn.example.com
# Domínio do site de ebooks (só vale quando o conjunto "ebooks" estiver ligado: scripts/proxy-site.sh).
EBOOKS_DOMAIN=ebooks.example.com
