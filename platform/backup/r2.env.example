# Copie para /etc/infra-backup/r2.env (modo 600, fora do Git). Token do R2 com "Object Read & Write"
# restrito ao bucket de backups. Nunca cole estes valores em chat, log ou captura de tela.
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=auto
R2_ENDPOINT=https://<ID-DA-CONTA>.r2.cloudflarestorage.com
R2_BUCKET=<NOME-DO-BUCKET>
